name: 更新每日收盤價

on:
  schedule:
    # 台灣時間（週一到週五）14:40、15:40、16:40、17:40、19:10、21:10
    - cron: "40 6 * * 1-5"
    - cron: "40 7 * * 1-5"
    - cron: "40 8 * * 1-5"
    - cron: "40 9 * * 1-5"
    - cron: "10 11 * * 1-5"
    - cron: "10 13 * * 1-5"
    # 台灣時間隔天早上 07:10（補抓前一個交易日，週二到週六）
    - cron: "10 23 * * 1-5"
  workflow_dispatch: {}

permissions:
  contents: write

concurrency:
  group: update-prices
  cancel-in-progress: false

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: 下載收盤價（證交所兩個來源＋櫃買中心）
        run: |
          UA="Mozilla/5.0 (stock-record-updater)"
          get() { curl -fsSL --retry 3 --max-time 60 -A "$UA" "$1" -o "$2" || echo "{}" > "$2"; }
          # 證交所網站版：收盤後較快更新
          get "https://www.twse.com.tw/rwd/zh/afterTrading/STOCK_DAY_ALL?response=json" twse_rwd.json
          get "https://www.twse.com.tw/rwd/zh/afterTrading/MI_INDEX?type=IND&response=json" index_rwd.json
          # 證交所 OpenAPI：備援
          get "https://openapi.twse.com.tw/v1/exchangeReport/STOCK_DAY_ALL" twse_open.json
          get "https://openapi.twse.com.tw/v1/exchangeReport/MI_INDEX" index_open.json
          # 櫃買中心 OpenAPI（上櫃股票，例如 8081）
          get "https://www.tpex.org.tw/openapi/v1/tpex_mainboard_daily_close_quotes" tpex.json

      - name: 整理成 prices.json（每檔股票保留最新日期的價格）
        run: |
          python3 - <<'PY'
          import json, re, datetime, os
          def load(f):
              try: return json.load(open(f, encoding="utf-8"))
              except Exception: return None
          def num(v):
              try:
                  n = float(str(v).replace(",", "").strip())
                  return n if n > 0 else None
              except Exception: return None
          def ymd(d):
              d = re.sub(r"\D", "", str(d or ""))
              if len(d) == 7: return f"{int(d[:3])+1911}-{d[3:5]}-{d[5:]}"
              if len(d) == 8: return f"{d[:4]}-{d[4:6]}-{d[6:]}"
              return ""
          def tables(j):
              """把各種 JSON 格式整理成 (fields, rows) 清單"""
              out = []
              if isinstance(j, dict):
                  if isinstance(j.get("fields"), list) and isinstance(j.get("data"), list):
                      out.append((j["fields"], j["data"]))
                  for t in j.get("tables") or []:
                      if isinstance(t, dict) and isinstance(t.get("fields"), list) and isinstance(t.get("data"), list):
                          out.append((t["fields"], t["data"]))
              return out

          old = load("prices.json") or {}
          best = {}  # code -> (date, price)
          def put(code, price, date):
              code = str(code or "").strip()
              if not code or not price or not date: return
              if code not in best or date > best[code][0]:
                  best[code] = (date, price)

          # 1) 證交所網站版
          j = load("twse_rwd.json")
          if isinstance(j, dict) and j.get("stat", "OK") == "OK":
              d = ymd(j.get("date"))
              for fields, rows in tables(j):
                  fs = [str(f) for f in fields]
                  ci = next((i for i, f in enumerate(fs) if "代號" in f), None)
                  pi = next((i for i, f in enumerate(fs) if "收盤" in f), None)
                  if ci is None or pi is None: continue
                  for r in rows:
                      if len(r) > max(ci, pi): put(r[ci], num(r[pi]), d)
          # 2) 證交所 OpenAPI
          j = load("twse_open.json")
          if isinstance(j, list):
              for r in j: put(r.get("Code"), num(r.get("ClosingPrice")), ymd(r.get("Date")))
          # 3) 櫃買中心
          j = load("tpex.json")
          if isinstance(j, list):
              for r in j: put(r.get("SecuritiesCompanyCode") or r.get("Code"), num(r.get("Close")), ymd(r.get("Date")))

          # 加權指數：取日期較新的來源
          taiex = None
          j = load("index_rwd.json")
          if isinstance(j, dict):
              d = ymd(j.get("date"))
              for fields, rows in tables(j):
                  fs = [str(f) for f in fields]
                  try:
                      ni = next(i for i, f in enumerate(fs) if f.startswith("指數"))
                      ci = next(i for i, f in enumerate(fs) if "收盤" in f)
                  except StopIteration: continue
                  si = next((i for i, f in enumerate(fs) if "+/-" in f or f.startswith("漲跌(")), None)
                  pi = next((i for i, f in enumerate(fs) if "點數" in f), None)
                  qi = next((i for i, f in enumerate(fs) if "百分比" in f), None)
                  for r in rows:
                      if "發行量加權股價指數" in str(r[ni]) and d:
                          neg = si is not None and ("-" in str(r[si]) or "green" in str(r[si]))
                          pts = num(r[pi]) if pi is not None else None
                          try: pct = float(str(r[qi]).replace(",", "")) if qi is not None else None
                          except Exception: pct = None
                          taiex = {"close": num(r[ci]), "chg": (-1 if neg else 1) * (pts or 0), "pct": pct, "date": d}
                          break
          j = load("index_open.json")
          if isinstance(j, list):
              for r in j:
                  if "發行量加權股價指數" in str(r.get("指數", "")):
                      d = ymd(r.get("日期"))
                      if not taiex or (d and d > taiex.get("date", "")):
                          neg = "-" in str(r.get("漲跌", ""))
                          try: pct = float(r.get("漲跌百分比"))
                          except Exception: pct = None
                          taiex = {"close": num(r.get("收盤指數")), "chg": (-1 if neg else 1) * (num(r.get("漲跌點數")) or 0), "pct": pct, "date": d}
                      break

          if not best:
              print("沒有取得任何價格，保留舊檔"); raise SystemExit(0)
          dates = sorted({v[0] for v in best.values()})
          latest = dates[-1]
          out = {"date": latest,
                 "updatedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
                 "count": len(best),
                 "taiex": taiex or old.get("taiex"),
                 "prices": {c: v[1] for c, v in best.items()},
                 "dates": {c: v[0] for c, v in best.items() if v[0] != latest}}
          json.dump(out, open("prices.json", "w", encoding="utf-8"), ensure_ascii=False, separators=(",", ":"))
          print("寫入", len(best), "檔價格，最新日期", latest, "；各來源日期：", dates[-3:])
          PY
          rm -f twse_rwd.json index_rwd.json twse_open.json index_open.json tpex.json

      - name: 存回 repository
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add prices.json
          git diff --cached --quiet || (git commit -m "更新收盤價" && git push)
